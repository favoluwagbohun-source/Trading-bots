{
  "name": "crypto-signal-platform",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run bundle --workspace apps/web",
    "dev": "npm run build && SERVE_WEB_ASSETS=true PORT=3000 HOST=0.0.0.0 node apps/api/dist/main.js",
    "start": "SERVE_WEB_ASSETS=true PORT=3000 HOST=0.0.0.0 node apps/worker/dist/render-entrypoint.js",
    "test": "vitest run",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "engines": {
    "node": ">=20"
  }
}
