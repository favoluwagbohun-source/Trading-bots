# Copy this file to .env.production and replace all placeholders before startup.
WATCHLIST_SYMBOLS=BTCUSDT,ETHUSDT
SCAN_INTERVAL_MS=30000
TELEGRAM_BOT_TOKEN=replace-with-a-secret-from-your-secret-manager
TELEGRAM_WEB_APP_URL=https://signals.example.com

# Illustrative paper-simulation assumptions only; set values appropriate to
# the validation assumptions for your deployment.
PAPER_FEE_RATE_PER_SIDE=0.001
PAPER_SLIPPAGE_RATE_PER_SIDE=0.001

# Leave empty unless you have actual, reviewable strategy validation evidence.
STRATEGY_QUALITY_EVIDENCE=

PAPER_MAX_OPEN_TRADES=3
PAPER_MAX_DAILY_LOSS_PERCENT=2
PAPER_MAX_WEEKLY_LOSS_PERCENT=6
PAPER_MAX_GROSS_EXPOSURE_PERCENT=100
PAPER_MAX_OPEN_PER_GROUP=1
